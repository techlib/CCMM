<?xml version="1.0" encoding="UTF-8"?>
<dataset
  xsi:schemaLocation="https://schema.ccmm.cz/research-data/2.0 https://raw.githubusercontent.com/techlib/CCMM/refs/heads/2.0.0/dataset/schema.xsd"
  xmlns="https://schema.ccmm.cz/research-data/2.0" xmlns:gml="http://www.opengis.net/gml/3.2"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- Metadata_identification: Data Manager -->
  <metadata_identification>
    <!--(1..*) shall contain at least one agent with role Data Manager-->
    <qualified_attribution>
      <attributed_agent>
        <person>
          <name>Pavel Steklý</name>
          <given_name>Pavel</given_name>
          <family_name>Staeklý</family_name>
        </person>
      </attributed_agent>
      <role>
        <iri>https://vocabs.ccmm.cz/registry/codelist/AgentRole/Contributor/DataManager</iri>
        <label xml:lang="en">Data Manager</label>
      </role>
    </qualified_attribution>

    <!-- (1..1) date updated -->
    <date_updated>2025-07-25</date_updated>
    <!-- (1..*) Conforms to standard: this is the minimal variant with an IRI -->
    <conforms_to_standard>
      <iri>https://model.ccmm.cz/research-data/2.0.0</iri>
      <label xml:lang="en">Czech Core Metadata Model for Research Data 2.0.0</label>
    </conforms_to_standard>
    <!-- (1..1) original repository -->
    <!-- (!..*) shall contain at least one agent with role Publisher -->
       <original_repository>
            <iri>https://data.narodni-repozitar.cz</iri>
            <label xml:lang="cs">Původní repozitář</label>
            <description xml:lang="cs">Popis původního repozitáře,</description>
            <qualified_attribution>
              <attributed_agent>
                <organization>
                  <name>Univerzita Karlova</name>
                </organization>
              </attributed_agent>
              <role>
                <iri>https://vocabs.ccmm.cz/registry/codelist/AgentRole/Publisher</iri>
                <label xml:lang="cs">Vydavatel</label>
                <label xml:lang="en">Publisher</label>
              </role>
            </qualified_attribution>
       </original_repository>
  </metadata_identification>

  <!-- (1-1) Identifier -->
  <identifier>
    <iri>https://doi.org/10.48700/datst.xd12h-dfz24</iri>
    <value>10.48700/datst.xd12h-dfz24</value>
    <scheme>
      <iri>https://doi.org/</iri>
    </scheme>
  </identifier>

  <!-- (1-1) Title; without alternate title type "translated title" – if provided, it must include the type -->
  <title>Datová sada pro Údaje o zdravotní gramotnosti a depresi seniorů ve věku 65 a více let</title>

  <!-- Qualified attribution: The usage note for “qualified attribution” specifies that
       each dataset shall have at least two qualified relations: one with role “Creator” 
       and the second with role "Publisher". -->
  <!-- Creator -->
  <qualified_attribution>
    <attributed_agent>
      <person>
        <name>Bártlová, Sylva</name>
        <given_name>Sylva</given_name>
        <family_name>Bártlová</family_name>
      </person>
    </attributed_agent>
    <role>
      <iri>https://vocabs.ccmm.cz/registry/codelist/AgentRole/Creator</iri>
      <label xml:lang="en">Creator</label>
    </role>
  </qualified_attribution>
  <!-- Publisher -->
  <qualified_attribution>
    <attributed_agent>
      <organization>
        <name>Nějaká organizace</name>
      </organization>
    </attributed_agent>
    <role>
      <iri>https://vocabs.ccmm.cz/registry/codelist/AgentRole/Publisher</iri>
      <label xml:lang="en">Publisher</label>
    </role>
  </qualified_attribution>
    
  <!-- (1-1) Publication year -->
  <publication_year>2026</publication_year>

  <!-- (1..*) Must contain at least one time reference "Created"; it must include either 
       a time_instant or a time_interval -->
  <time_reference>
       <temporal_representation>
            <time_instant>
                 <date>2024-05-01</date>
            </time_instant>
       </temporal_representation>
       <date_type>
            <iri>https://vocabs.ccmm.cz/registry/codelist/TimeReference/Created</iri>
            <label xml:lang="en">Created</label>
       </date_type>
  </time_reference>
  
  <!-- (1-1) Specify one access rights -->
  <access_rights>
    <iri>http://purl.org/coar/access_right/c_f1cf</iri>
    <label xml:lang="en">embargoed access</label>
  </access_rights>

  <!-- (1-*) Specify at least one subject. At least one subject must be a value from FRASCATI FORD vocabulary. There must be title, classification_code and subject_scheme. -->
  <subject>
    <iri>https://vocabs.ccmm.cz/registry/codelist/SubjectCategory/30000/30300/30304</iri>
    <title xml:lang="cs">Veřejné a environmentální zdraví</title>
    <classification_code>10509</classification_code>
    <subject_scheme>
      <iri>https://vocabs.ccmm.cz/registry/codelist/SubjectCategory/</iri>
    </subject_scheme>
  </subject>
  
  <!-- (1-*) Specify at least one description -->
  <description>
    <description_text xml:lang="cs">Toto je jen ukázka metadat pro neexistující datovou sadu.</description_text>
  </description>

</dataset>
