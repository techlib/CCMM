{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model.ccmm.cz/research-data/access-rights/schema.json",
  "title": "Access rights",
  "description": "A statement about the access rights to the resource.",
  "type": "object",
  "required": [
    "id",
    "label"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "iri"
    },
    "type": {
      "oneOf": [
        {
          "const": "access_rights"
        },
        {
          "type": "array",
          "contains": {
            "const": "access_rights"
          },
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "label": {
      "title": "label",
      "description": "A human-readable name for the subject.",
      "type": "object",
      "additionalProperties": {
        "title": "Hodnota v jiném jazyce",
        "type": "string"
      },
      "properties": {
        "cs": {
          "title": "Hodnota v českém jazyce",
          "type": "string"
        },
        "en": {
          "title": "Hodnota v anglickém jazyce",
          "type": "string"
        }
      }
    }
  }
}